<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml: only the backed-up key-value file, never the
     device token (kept in noBackupFilesDir). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="kv/backup.properties" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="kv/backup.properties" />
    </device-transfer>
</data-extraction-rules>
