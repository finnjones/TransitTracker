# TransitTracker server settings.
# Copy to deploy/.env (which git ignores) and fill in the blanks:
#   cp .env.example .env && chmod 600 .env
# Never commit .env, and never paste its values into chats, issues or screenshots.
# Lines starting with # are ignored; a commented-out setting uses the default shown.

# ---------------------------------------------------------------------------------------------
# Cloudflare Tunnel (used by docker-compose.yml, not by tt-server)

# Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel (Docker option:
# the long value after --token). Secret: anyone with it can run your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# cloudflared image tag; pin to a release (see hub.docker.com/r/cloudflare/cloudflared/tags).
# CLOUDFLARED_VERSION=latest

# Image to run. Leave unset to build from this repository; set to the CI-published image to pull it:
# TT_IMAGE=ghcr.io/<github-owner>/<repo>/tt-server:latest

# ---------------------------------------------------------------------------------------------
# Required

# TfNSW Open Data Hub API key (https://opendata.transport.nsw.gov.au). Without it there are no
# timetables, live data or journey planning. The application behind the key needs the timetable,
# realtime and "Trip Planner APIs" products (deploy/README.md step 4).
TFNSW_API_KEY=

# Public base URL phones use: the public hostname you gave the tunnel.
TT_PUBLIC_BASE_URL=https://tt.example.com

# ---------------------------------------------------------------------------------------------
# Push notifications (optional; leave blank to run without push)

# Path *inside the container* of the Firebase service-account JSON. Put the file in
# deploy/secrets/firebase-service-account.json and use:
# FIREBASE_SERVICE_ACCOUNT=/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
# Firebase project id (Project settings > General), e.g. transittracker-12345
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Admin

# Long random string that unlocks /status through the public URL
# (send "Authorization: Bearer <token>"). Generate one with:  openssl rand -base64 32
# Leave blank to allow /status only from the server itself.
TT_ADMIN_TOKEN=

# ---------------------------------------------------------------------------------------------
# Optional tuning (defaults shown)

# How often phones poll for live data, and while tracking one service (seconds).
# TT_POLL_INTERVAL_S=30
# TT_TRACKER_POLL_INTERVAL_S=15
# Stop calling TfNSW for the rest of the Sydney day after this many calls (live feeds and journey
# planner together; TfNSW's own limit is 60,000 a day per key).
# TT_DAILY_CALL_BUDGET=50000
# TfNSW allows 5 calls per second; stay under it.
# TT_MAX_CALLS_PER_SECOND=4
# Local hour (Australia/Sydney) for the nightly timetable check.
# TT_NIGHTLY_BUILD_HOUR=3
# Lowest app version allowed to use the server.
# TT_MIN_APP_VERSION=0
# Banner text shown in the app, e.g. "Server maintenance Sunday 10pm".
# TT_STATUS_MESSAGE=
# Attribution shown in the app (TfNSW terms require attribution).
# TT_ATTRIBUTION=Contains Transport for NSW data
# TfNSW API base URL.
# TFNSW_BASE_URL=https://api.transport.nsw.gov.au
# Log level: ERROR, WARN, INFO or DEBUG.
# TT_LOG_LEVEL=INFO
# Save a raw copy of each live feed at most every N minutes (for replay tests); 0 turns it off.
# TT_RECORD_INTERVAL_MIN=10
# Days of raw feed recordings to keep (they are saved under <data dir>/recordings/<YYYYMMDD>/).
# TT_RECORD_RETENTION_DAYS=7
# Days of service each timetable pack covers from its build date.
# TT_PACK_WINDOW_DAYS=70
# MobilityData GTFS Validator CLI JAR to run on each downloaded timetable before publishing it
# (its errors block the build). Not included in the image: put the JAR in the data volume and
# give its path inside the container, e.g. /data/gtfs-validator-cli.jar. Unset skips it.
# TT_GTFS_VALIDATOR_JAR=
# Development only: serve live feeds from recorded files (<feed>-<kind>[-<epochMs>].pb[.gz],
# e.g. a copy of <data dir>/recordings) instead of calling TfNSW. Recording is off while replaying.
# Journey planning is then answered from <dir>/planner/trip.json and stop_finder[-<query>].json
# (see testdata/planner/README.md; testdata/planner/replay works with the mini-rail timetable).
# TT_REPLAY_DIR=

# Set by docker-compose.yml inside the container; only change them when running tt-server
# outside Docker.
# Reverse proxy whose client-address header is trusted: cloudflare (CF-Connecting-IP) or none.
# TT_TRUSTED_PROXY=cloudflare
# TT_PORT=8080
# TT_DATA_DIR=/data
